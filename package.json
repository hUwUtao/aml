{
  "name": "aml",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "test": "bun run --workspaces test",
    "check": "bun run --workspaces check",
    "build": "bunx --bun tsdown --config tsdown.config.mts",
    "release": "bun run test && bun run check && bun run build && bun run pages",
    "pages": "bun scripts/publish-pages.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "oxfmt": "^0.66.0",
    "tsdown": "0.22.14",
    "typescript": "^7.0.2"
  }
}
